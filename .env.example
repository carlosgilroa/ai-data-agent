# Gemini API Key (Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here

# Model Selection & Intent Routing
GEMINI_ROUTER_MODEL=gemini-3.1-flash-lite
GEMINI_SIMPLE_MODEL=gemini-3.5-flash-lite
GEMINI_MODEL=gemini-3.8-flash

# Semantic RAG Thresholds
RAG_TOP_K=5
RAG_MIN_SIMILARITY=0.28

# Data Paths
WALLET_DATA_DIR=C:/projects/wallet/data
LOOKML_DIR=C:/projects/wallet-lookml
CHROMA_PERSIST_DIR=data/chroma

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=True

# Semantic layer
# Fix "today" for relative dates like "last month" (YYYY-MM-DD); leave empty to use the real date
AGENT_TODAY=
# Allow read-only raw SQL when no LookML explore fits; such answers are marked as not governed
ALLOW_RAW_SQL_FALLBACK=True
# Number of catalog entries (explores, measures, dimensions) put in the prompt for each question
SEMANTIC_SEARCH_TOP_K=12
# Where each agent answer's full trace (steps, tools, tokens) is appended; leave empty to disable
QUERY_LOG_PATH=logs/agent_queries.jsonl
