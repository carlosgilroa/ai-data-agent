# Gemini API Key (Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here

# Model Selection & Intent Routing
GEMINI_ROUTER_MODEL=gemini-3.1-flash-lite
GEMINI_SIMPLE_MODEL=gemini-3.5-flash-lite
GEMINI_MODEL=gemini-3.8-flash

# Semantic RAG Thresholds
RAG_TOP_K=5
RAG_MIN_SIMILARITY=0.28

# Data Paths
WALLET_DATA_DIR=C:/projects/wallet/data
LOOKML_DIR=C:/projects/wallet-lookml
CHROMA_PERSIST_DIR=data/chroma

# Conversation memory (SQLite): last turns per session, deleted after a week without activity
SESSION_DB_PATH=data/sessions.db
SESSION_MAX_TURNS=10
SESSION_TTL_HOURS=168

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=True

# Semantic layer
# Fix "today" for relative dates like "last month" (YYYY-MM-DD); leave empty to use the real date
AGENT_TODAY=
# Allow read-only raw SQL when no LookML explore fits; such answers are marked as not governed
ALLOW_RAW_SQL_FALLBACK=True
# Stop the tool loop and answer once a question has used this many input tokens (0 = no ceiling)
MAX_INPUT_TOKENS_PER_QUESTION=40000
# Reload the parquet files when they change, once untouched for this many seconds
DATA_RELOAD_STABLE_SECONDS=60
# Retrieval per question: explores first, then measures and dimensions within them, then instructions
RETRIEVAL_EXPLORES=3
RETRIEVAL_MEASURES=5
RETRIEVAL_DIMENSIONS=5
RETRIEVAL_GLOSSARY=3
RETRIEVAL_GOLDEN_QUERIES=2
# Glossary, default filters and golden queries (Looker data agent instructions)
AGENT_INSTRUCTIONS_PATH=agent_instructions.yaml
# Where each agent answer's full trace (steps, tools, tokens) is appended; leave empty to disable
QUERY_LOG_PATH=logs/agent_queries.jsonl
